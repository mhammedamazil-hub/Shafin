plane ground { material: concrete }

box counter { size: [2, 0.75, 1], material: wood, on: ground }

cup bowl { radius: 0.15, top_radius: 0.18, height: 0.1, wall: 0.01, material: ceramic, color: white, on: counter, at: [0.3, 0] }

sphere orange1 { radius: 0.08, color: orange, material: plastic, in: bowl, at: [0.02, 0.02] }
sphere orange2 { radius: 0.08, color: orange, material: plastic, in: bowl, at: [-0.02, 0.02] }
sphere orange3 { radius: 0.08, color: orange, material: plastic, in: bowl, at: [0.02, -0.02] }
sphere orange4 { radius: 0.08, color: orange, material: plastic, in: bowl, at: [-0.02, -0.02] }

cup glass { radius: 0.04, top_radius: 0.05, height: 0.1, wall: 0.004, material: glass, color: white, on: counter, at: [0.6, 0] }

sky { time: morning }

camera { look_at: bowl, azimuth: 30, elevation: 20, fov: 35, distance: 1.5 }

render { size: [1280, 720], samples: 64 }
